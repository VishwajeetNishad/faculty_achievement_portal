<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test-only logging: console output, NO rolling log files.

  Logback loads logback-test.xml (when present on the test classpath) in
  preference to logback-spring.xml, so running the unit tests does not create
  or write to the production "logs" directory.
-->
<configuration>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
