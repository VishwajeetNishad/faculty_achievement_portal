# ====================================================================
# Faculty Achievement Portal — environment configuration TEMPLATE
# ====================================================================
# HOW TO USE:
#   1. Copy this file to ".env"        ->   cp .env.example .env
#   2. Fill in the real values below (especially every *_PASSWORD and JWT_SECRET).
#   3. NEVER commit the real ".env" — it is git-ignored on purpose. Only THIS
#      template (.env.example) is committed, and it must contain no real secrets.
#
# docker-compose reads ".env" automatically when you run `docker compose up -d`.
# --------------------------------------------------------------------

# --- Your public domain (no "http://"). Point its DNS A-record at this server. ---
# For a quick LOCAL test you may use:  DOMAIN=localhost
DOMAIN=portal-niet.example

# --- Email address for Let's Encrypt HTTPS certificate notices. ---
ACME_EMAIL=admin@portal-niet.example

# --- Database ---
# Name of the database to create.
DB_NAME=faculty_achievement_db
# A DEDICATED application user (NOT root). The MySQL container creates it for you.
DB_USERNAME=faculty_app
# Strong password for the application DB user.  >>> CHANGE THIS <<<
DB_PASSWORD=change_me_db_app_password
# Separate password for the MySQL root (admin) account.  >>> CHANGE THIS <<<
MYSQL_ROOT_PASSWORD=change_me_db_root_password

# --- Authentication (JWT login tokens) ---
# Secret key used to sign login tokens. MUST be at least 32 characters (256 bits).
# Generate a strong random one, for example:   openssl rand -base64 48
JWT_SECRET=change_me_generate_a_64_char_random_secret_key
# How long a login stays valid, in milliseconds (default 24h = 86400000).
JWT_EXPIRATION_MS=86400000

# --- First administrator account (created ONCE, on first startup only) ---
# Leave ADMIN_EMAIL and ADMIN_PASSWORD blank to skip automatic admin creation.
ADMIN_EMAIL=admin@niet.co.in
ADMIN_PASSWORD=change_me_strong_admin_password
ADMIN_EMPLOYEE_ID=EMP001
ADMIN_FULL_NAME=System Administrator
ADMIN_DESIGNATION=Administrator
ADMIN_DEPARTMENT_CODE=CSE
ADMIN_PHONE=

# --- Public share links ---
# The address share links point at. The server builds the whole URL from this, so
# the link a faculty member copies is correct without a code change.
# In production this should be your real site:  https://portal-niet.example
# For local development the backend already defaults to http://localhost:5500,
# so you can leave this blank when running locally.
SHARE_BASE_URL=https://portal-niet.example
